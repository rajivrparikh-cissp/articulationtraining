# ==============================================================================
# ExecutiveVoice Environment Variables (Production & Local Staging)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/v1/audio/stream

# Database / Cloud SQL PostgreSQL
DATABASE_URL=postgresql://executive_user:executive_pass@localhost:5432/executive_voice_db?schema=public

# Cloud Storage / Audio Recordings
AUDIO_STORAGE_BUCKET=executive-voice-audio-vault
GCP_PROJECT_ID=executive-voice-prod
GCP_KMS_KEY_NAME=projects/executive-voice-prod/locations/global/keyRings/audio-vault/cryptoKeys/audio-recording-enc

# Speech-to-Text & LLM Engine APIs
GOOGLE_SPEECH_TO_TEXT_API_KEY=your_google_cloud_stt_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication & JWT
JWT_SECRET=super_secret_enterprise_jwt_key_32_chars_min
WEBAUTHN_RP_NAME=ExecutiveVoice
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Security Nonce & Encryption
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
